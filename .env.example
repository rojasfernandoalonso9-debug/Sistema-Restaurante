# MySQL local development. Replace placeholders locally; do not commit real values.
DB_URL=jdbc:mysql://localhost:3306/restaurante?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_USERNAME=change_me
DB_PASSWORD=

# Generate a private 32+ character key before starting the backend.
JWT_SECRET=replace_with_a_private_random_string_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Frontend API base URL (create frontend/.env.local for local overrides).
VITE_API_URL=http://localhost:8080/api
